OPENAI_API_KEY=
GROQ_API_KEY=
AI_AGENT_ENVIRONMENT=local
AI_AGENT_LOG_LEVEL=INFO
AI_AGENT_SERVICE_NAME=commerce-adaptive-rag
AI_AGENT_MODEL_PROVIDER=groq
AI_AGENT_MODEL_NAME=llama-3.1-8b-instant
AI_AGENT_MODEL_TEMPERATURE=0
# OpenAI-compatible endpoint, e.g. https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_AGENT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_AGENT_MODEL_MAX_TOKENS=2048
# Empty reuses the answer model. Set a smaller served model for planning/grading if available.
AI_AGENT_QUERY_MODEL_NAME=
AI_AGENT_QUERY_MODEL_MAX_TOKENS=1200
AI_AGENT_RAG_DECISION_TOKEN_BUDGET=16000
AI_AGENT_RAG_MAX_SEARCH_CALLS=9
AI_AGENT_RAG_CONTEXT_MAX_CHARS=12000
AI_AGENT_AGENT_HISTORY_TURNS=4
AI_AGENT_CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
AI_AGENT_RAG_ENABLED=true
AI_AGENT_RAG_COLLECTION_NAME=scientific_knowledge
AI_AGENT_RAG_TOP_K=4
AI_AGENT_RAG_RETRIEVAL_MODE=adaptive
AI_AGENT_RAG_SPARSE_MODEL_NAME=Qdrant/bm25
AI_AGENT_RAG_RERANKER_ENABLED=false
AI_AGENT_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
AI_AGENT_RAG_CHUNK_STRATEGY=parent_child
AI_AGENT_RAG_PARENT_CHUNK_SIZE=2000
AI_AGENT_RAG_EVIDENCE_RETRY_LIMIT=2
AI_AGENT_RAG_OCR_ENABLED=false
AI_AGENT_RAG_VLM_ENABLED=false
AI_AGENT_RAG_VLM_MODEL=gpt-4o-mini
AI_AGENT_RAG_VOICE_TOP_K=4
AI_AGENT_RAG_CHUNK_SIZE=1000
AI_AGENT_RAG_CHUNK_OVERLAP=150
AI_AGENT_RAG_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
AI_AGENT_RAG_EMBEDDING_DIMENSIONS=384
AI_AGENT_QDRANT_URL=http://localhost:6333
AI_AGENT_QDRANT_STORAGE_PATH=.qdrant
QDRANT_API_KEY=
AI_AGENT_OTEL_ENABLED=false
AI_AGENT_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Legacy API keys: empty disables auth only locally; production fails closed.
AI_AGENT_AUTH_API_KEYS=[]
AI_AGENT_RATE_LIMIT_ENABLED=true
AI_AGENT_RATE_LIMIT_REQUESTS=60
AI_AGENT_RATE_LIMIT_WINDOW_SECONDS=60
AI_AGENT_REQUEST_MAX_BODY_BYTES=5242880

# memory = in-process LangGraph checkpointer (thread-id memory across calls).
# none = no checkpointer.
AI_AGENT_AGENT_CHECKPOINT_BACKEND=memory

AI_AGENT_RAG_SEARCH_MULTIPLIER=3

# Durable evidence/cache storage is separate from Qdrant storage.
AI_AGENT_RAG_DATA_PATH=.rag
AI_AGENT_RAG_NAMESPACE=default
AI_AGENT_RAG_VERIFICATION_LEVEL=semantic
AI_AGENT_RAG_ANSWER_REPAIR_LIMIT=1
AI_AGENT_RAG_VERIFIER_MODEL_NAME=
AI_AGENT_RAG_EMBEDDING_MODEL_REVISION=default
AI_AGENT_RAG_EMBEDDING_PARAMETERS={}

# Explicit offline Demo (never presented as real model inference).
AI_AGENT_COMMERCE_MODE=demo
AI_AGENT_COMMERCE_DATABASE_URL=sqlite:///.commerce/business.sqlite3
AI_AGENT_COMMERCE_LLM_MODE=offline
AI_AGENT_COMMERCE_SEED_DEMO=true
AI_AGENT_COMMERCE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_AGENT_COMMERCE_EMBEDDING_DIMENSIONS=384
# Production: PostgreSQL + explicit opaque bearer credentials mapped to store and role.
# AI_AGENT_COMMERCE_MODE=production
# AI_AGENT_COMMERCE_DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/commerce
# AI_AGENT_COMMERCE_PRINCIPALS={"replace-with-secret-token":{"store_id":"seller-a","subject":"operator-a","role":"operator","marketplaces":["US"]}}
AI_AGENT_COMMERCE_PRINCIPALS={}
# Operator-defined example limits, not a current platform policy guarantee.
AI_AGENT_COMMERCE_LISTING_RULES={"amazon:US":{"title_max":200,"bullets_max":5},"amazon:DE":{"title_max":180,"bullets_max":5},"shopify:US":{"title_max":255,"bullets_max":8}}
